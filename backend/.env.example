# =============================================================================
# SMART FOOD RESCUE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# --- Environment Mode ---
# Options: development | staging | production
ENVIRONMENT=production
DEBUG=false

# --- Project Metadata ---
PROJECT_NAME="Smart Food Rescue Platform"
API_V1_STR=/api

# --- Database Configuration ---
# Local SQLite Development:
# DATABASE_URL=sqlite:///./smart_food.db
# Production PostgreSQL:
DATABASE_URL=postgresql://sfr_user:sfr_secure_password@localhost:5432/smart_food_rescue

# --- Security & JWT Authentication ---
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_SECRET=replace-with-a-distinct-secure-random-refresh-key
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate Limiting & Lockout ---
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=300

# --- OTP Expiration Policies ---
OTP_PICKUP_EXPIRE_MINUTES=5
OTP_PHONE_VERIFY_EXPIRE_MINUTES=10
OTP_REGEN_MAX_PER_WINDOW=3
OTP_REGEN_WINDOW_MINUTES=10
OTP_PHONE_VERIFY_MAX_PER_WINDOW=3
OTP_PHONE_VERIFY_WINDOW_MINUTES=15

# --- Real SMS Provider Configuration ---
# Options: mock | twilio | fast2sms | msg91
SMS_PROVIDER=mock
SMS_API_KEY=your_provider_api_key_or_twilio_account_sid
SMS_API_SECRET=your_provider_api_secret_or_twilio_auth_token
SMS_SENDER_ID=SFRESCUE
SMS_TEMPLATE_ID=your_dlt_template_id
SMS_WEBHOOK_SECRET=your_configured_webhook_secret

# --- Real Road Routing Provider ---
# Options: heuristic | google | osrm
ROUTING_PROVIDER=heuristic
GOOGLE_MAPS_API_KEY=your_google_maps_directions_api_key
ROUTING_TIMEOUT_SECONDS=5.0

# --- Genuine AI Vision Provider ---
# Options: gemini | local
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key
AI_TIMEOUT_SECONDS=10.0

# --- Push Notifications (Firebase Cloud Messaging) ---
FCM_SERVER_KEY=your_firebase_server_key_or_service_account_path
FCM_PROJECT_ID=smart-food-rescue-firebase-id
FIREBASE_CREDENTIALS_PATH=path/to/firebase_service_account.json

# --- CORS Allowed Origins ---
# Comma-separated domains for production web/admin clients
CORS_ORIGINS=https://app.smartfoodrescue.org,https://admin.smartfoodrescue.org

